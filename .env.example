# ==============================================================================
# T2T DRIVE — Environment Configuration Template
# ==============================================================================
# Copy this file to backend/.env and configure values before starting the application.
# Never commit real credentials, passwords, or production connection strings to Git.

# --- Application Environment ---
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=0.0.0.0

# Secret keys (In production, must be at least 32 characters, random and distinct)
SECRET_KEY=dev-secret-key-t2t-drive-2026-minimum-32-chars
JWT_SECRET=jwt-secret-t2t-drive-key-2026-minimum-32-chars
OTP_HASH_SECRET=dev-otp-hash-secret-t2t-drive-2026-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRATION_HOURS=24

# --- CORS Configuration (Restricted frontend origins) ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5000

# --- MongoDB Atlas Configuration ---
MONGODB_URI=mongodb://localhost:27017/t2t_drive
DB_NAME=t2t_drive

# Dedicated Disposable Test Database (Required for live MongoDB integration tests)
TEST_LIVE_MONGODB_URI=
TEST_LIVE_MONGODB_DB=t2t_drive_integration_test

# --- SMS Provider Adapter ---
# Provider mode: "mock" (offline/test) or "live"
SMS_PROVIDER_MODE=mock
SMS_API_KEY=
SMS_SENDER_ID=T2TDRV

# --- Gnani Voice Services (Prisma STT & Timbre TTS) ---
GNANI_BASE_URL=https://api.vachana.ai
GNANI_API_KEY=
GNANI_PRISMA_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_TIMBRE_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference

# Voice Pipeline Mode: "mock" (offline/test) or "live"
VOICE_PROVIDER_MODE=mock
GNANI_PRISMA_ENABLED=0
GNANI_TIMBRE_ENABLED=0
VOICE_MAX_UPLOAD_MB=10
VOICE_MAX_DURATION_SECONDS=60
VOICE_TEMP_DIRECTORY=

# --- Phase 5: Documents, OCR, Challan & Reminders ---
DOCUMENT_STORAGE_MODE=local
DOCUMENT_STORAGE_PATH=uploads/documents
DOCUMENT_MAX_UPLOAD_MB=10
DOCUMENT_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg
DOCUMENT_EXPIRY_THRESHOLDS=30,15,7,1,0
OCR_ENABLED=1
OCR_PROVIDER=mock
REMINDER_NOTIFICATION_MODE=mock

# --- Phase 6: Noise Intelligence Engine ---
AUDIO_NOISE_ANALYSIS_ENABLED=1
AUDIO_SNR_ENABLED=1
AUDIO_VAD_ENABLED=1
AUDIO_ADAPTIVE_PREPROCESSING_ENABLED=1
AUDIO_NOISE_REDUCTION_ENABLED=1
AUDIO_MAX_RETRIES=3
AUDIO_QUALITY_THRESHOLD=POOR
AUDIO_MIN_SPEECH_DURATION=0.2
AUDIO_MAX_PROCESSING_DURATION=5.0
