# T2T DRIVE - Environment Configuration Template
# Copy this file to .env and customize values for your deployment.

# Application Environment
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
PORT=5000
HOST=0.0.0.0

# CORS Configuration (Restricted frontend origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5000

# MongoDB Atlas Database
MONGODB_URI=mongodb://localhost:27017/t2t_drive
DB_NAME=t2t_drive

# JWT Authentication
JWT_SECRET=change-this-jwt-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRATION_HOURS=24

# Dedicated Server-Side OTP Hashing Secret (HMAC-SHA-256)
# Must be distinct from JWT_SECRET and SECRET_KEY
OTP_HASH_SECRET=change-this-to-a-secure-random-otp-hash-secret-in-production

# SMS Provider Adapter Configuration
# Mode: "mock" (for testing/development) or "live"
SMS_PROVIDER_MODE=mock
SMS_API_KEY=
SMS_SENDER_ID=T2TDRV

# Gnani Voice & Reasoning Services (Phase 3 & Phase 4)
GNANI_BASE_URL=https://api.vachana.ai
GNANI_API_KEY=
GNANI_PRISMA_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_TIMBRE_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference

# Gnani Evon LLM Inference Server (Phase 3)
# URL of external OpenAI-compatible vLLM/TGI inference cluster or mock
GNANI_EVON_INFERENCE_URL=http://localhost:8000/v1/chat/completions
GNANI_EVON_MODEL_NAME=gnani-evon
